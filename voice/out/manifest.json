[
 {
  "n": 0,
  "shot": 0,
  "line": 0,
  "spk": "periyappa",
  "text": "டேய் கார்த்தி! எப்படி டா இருக்க? ரொம்ப நாளாச்சு பாத்து.",
  "file": "00.mp3"
 },
 {
  "n": 1,
  "shot": 0,
  "line": 1,
  "spk": "karthi",
  "text": "நல்லா இருக்கேன் பெரியப்பா.",
  "file": "01.mp3"
 },
 {
  "n": 2,
  "shot": 0,
  "line": 2,
  "spk": "periyappa",
  "text": "இப்போ என்ன பண்ணிட்டு இருக்க?",
  "file": "02.mp3"
 },
 {
  "n": 3,
  "shot": 0,
  "line": 3,
  "spk": "karthi",
  "text": "சென்னைல ஒரு ஐடி கம்பெனில வேலை பாக்குறேன் பெரியப்பா.",
  "file": "03.mp3"
 },
 {
  "n": 4,
  "shot": 0,
  "line": 4,
  "spk": "periyappa",
  "text": "நம்ம சுந்தர் பையன் அமெரிக்கால இருக்கான், தெரியுமா?",
  "file": "04.mp3"
 },
 {
  "n": 5,
  "shot": 0,
  "line": 5,
  "spk": "karthi",
  "text": "தெரியும் பெரியப்பா... எல்லாருக்கும் தெரியும்.",
  "file": "05.mp3"
 },
 {
  "n": 6,
  "shot": 1,
  "line": 0,
  "spk": "periyappa",
  "text": "ஓஹோ. சம்பளம் எவ்வளவு டா?",
  "file": "06.mp3"
 },
 {
  "n": 7,
  "shot": 1,
  "line": 1,
  "spk": "karthi",
  "text": "அது... பரவாயில்ல பெரியப்பா.",
  "file": "07.mp3"
 },
 {
  "n": 8,
  "shot": 2,
  "line": 0,
  "spk": "amma",
  "text": "அண்ணா, இவனுக்கு ஒரு நல்ல பொண்ணா பாருங்க.",
  "file": "08.mp3"
 },
 {
  "n": 9,
  "shot": 2,
  "line": 1,
  "spk": "periyappa",
  "text": "ஆமா டா, கல்யாணம் எப்போ?",
  "file": "09.mp3"
 },
 {
  "n": 10,
  "shot": 4,
  "line": 0,
  "spk": "karthi",
  "text": "ஹலோ சார்... ஆமா சார்... அர்ஜென்ட் மீட்டிங்கா? இதோ வரேன் சார்!",
  "file": "10.mp3"
 },
 {
  "n": 11,
  "shot": 4,
  "line": 1,
  "spk": "periyappa",
  "text": "டேய்! சாப்பிட்டுட்டு போ டா!",
  "file": "11.mp3"
 },
 {
  "n": 12,
  "shot": 4,
  "line": 2,
  "spk": "amma",
  "text": "டேய், மொய் கவர் கொடுத்துட்டு போ டா!",
  "file": "12.mp3"
 },
 {
  "n": 13,
  "shot": 5,
  "line": 0,
  "spk": "karthi",
  "text": "அப்பாடா... தப்பிச்சேன்.",
  "file": "13.mp3"
 }
]