   "lines": [
    {
     "spk": "narrator",
     "text": "ஓம் சரவணபவ."
    }
   ]
  },
  {
   "shot": "murugan",
   "pre": 0.4,
   "post": 0.6,
   "lines": [
    {
     "spk": "narrator",
     "text": "தமிழ்க் கடவுள் முருகன். அழகின் வடிவம், ஞானத்தின் ஒளி."
    }
   ]
  },
  {
   "shot": "sparks",
   "pre": 0.4,
   "post": 0.5,
   "lines": [
    {
     "spk": "narrator",
     "text": "சிவனின் நெற்றிக்கண்ணில் இருந்து பிறந்த ஆறு தீப்பொறிகள், சரவணப் பொய்கையில் ஆறு குழந்தைகளாக மலர்ந்தன."
    }
   ]
  },
  {
   "shot": "merge",
   "pre": 0.3,
   "post": 0.6,
   "lines": [
    {
     "spk": "narrator",
     "text": "அன்னை பார்வதி அந்த ஆறு குழந்தைகளையும் ஒன்றாக அணைத்தாள். ஆறுமுகன் தோன்றினான்."
    }
   ]
  },
  {
   "shot": "vel",
   "pre": 0.3,
   "post": 0.6,
   "lines": [
    {
     "spk": "narrator",
     "text": "அன்னை தந்த ஞானவேலால், சூரபத்மனை வென்று, உலகைக் காத்தான் முருகன்."
    }
   ]
  },
  {
   "shot": "abodes",
   "pre": 0.3,
   "post": 0.8,
   "lines": [
    {
     "spk": "narrator",
     "text": "திருப்பரங்குன்றம், திருச்செந்தூர், பழனி, சுவாமிமலை, திருத்தணி, பழமுதிர்சோலை. அறுபடை வீடுகளிலும் அருள் புரிகிறான்."
    }
   ]
  },
  {
   "shot": "peacock",
   "pre": 0.3,
   "post": 0.6,
   "lines": [
    {
     "spk": "narrator",
     "text": "மயில் மீது அமர்ந்து, சேவல் கொடியுடன், கேட்டவர்க்கு கேட்டதை அருளும் கந்தன்."
    }
   ]
  },
  {
   "shot": "chant",
   "pre": 0.4,
   "post": 0.4,
   "lines": [
    {
     "spk": "narrator",
     "text": "துன்பம் வந்தால், மனதார ஒரு முறை சொல்லுங்கள்."
    },
    {
     "spk": "chant",
     "text": "வெற்றிவேல் முருகனுக்கு, அரோகரா!"
    }
   ]
  },
  {
   "shot": "end",
   "pre": 0.4,
   "post": 3.4,
   "lines": [
    {
     "spk": "narrator",
     "text": "முருகா சரணம்."
    }
   ],
   "caption_end": "வெற்றிவேல் முருகனுக்கு அரோகரா"
  }
 ]
}